# ── Firebase / Google ──────────────────────────────────────────────────────────────────────
*.json
!package.json
!tsconfig*.json
# Structural config, not secrets — flutter_launcher_icons/flutter build write
# into these; google-services.json (real credentials) stays ignored above.
!frontend/web/manifest.json
!frontend/ios/Runner/Assets.xcassets/AppIcon.appiconset/Contents.json
# Hosting config, not a secret — CI checks this out to deploy, and without it
# action-hosting-deploy fails with "firebase.json file not found".
!frontend/firebase.json
# Derived agronomic reference data, not a secret and not runtime state. The
# recommendation service reads it at boot to build the per-crop suitability
# flags; unshipped, every flag silently reads false. Regenerated by
# backend/scripts/derive_crop_bands.py. The other backend/data/*.json files
# stay ignored on purpose — those are mutable runtime state.
!backend/data/crop_agronomic_bands.json
frontend/windows/flutter/ephemeral/
backend/bandit_report.txt
frontend/build/*.dill
frontend/build/*.cache.dill.track.dill
frontend/build/*/.filecache
frontend/macos/Flutter/GeneratedPluginRegistrant.swift
frontend/windows/flutter/generated_plugin_registrant.cc
frontend/windows/flutter/generated_plugins.cmake

# Local planning / prompt docs — kept on-machine, not shared
ADMIN_REDESIGN_PROMPT.md

# Auto-generated per-directory description files — not source
description.md

# Docs
docs/
docs/database_design.md
# Tracked on purpose: the standing list of known defects in the weather /
# crop-suitability path. It has to be readable by the team and by anyone
# picking this up later, so it cannot live in an ignored tree — the detailed
# writeup previously sat in backend/data/description.md, which is ignored.
#
# Three lines, not one: `docs/` above excludes the DIRECTORY, and git never
# descends into an excluded directory, so a lone negation for a file inside it
# does nothing. Re-include the directory, re-exclude its contents, then
# negate the one file.
!backend/docs/
backend/docs/*
!backend/docs/known_issues.md
