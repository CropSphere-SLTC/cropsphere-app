# Copy this file to .env and fill in real values. Never commit .env to git.

APP_ENV=development

# Firebase — set FIREBASE_CREDENTIALS_JSON to the raw JSON string (for Railway)
# or a path to the service account file (for local dev)
FIREBASE_CREDENTIALS_JSON=/path/to/firebase-credentials.json
FIREBASE_PROJECT_ID=cropsphere-prod

# Groq API key for LLaMA 3 chatbot
GROQ_API_KEY=your-groq-api-key-here

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://cropsphere.web.app,https://cropsphere-2e87c.web.app,https://cropsphere-2e87c.firebaseapp.com

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=30

# Model files directory (mounted into container at runtime)
MODEL_DIR=/app/models/files

# ── Email alerts (admin notifications) ────────────────────────────────────────
# OFF by default — leave EMAIL_ENABLED=false until SMTP is configured, and no
# mail is ever sent (safe for dev/test). For Gmail: create an App Password
# (Google Account → Security → 2-Step Verification → App passwords) and use it
# as EMAIL_SMTP_PASSWORD. Never commit real credentials.
EMAIL_ENABLED=false
EMAIL_FROM=cropsphere.alerts@gmail.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=cropsphere.alerts@gmail.com
EMAIL_SMTP_PASSWORD=your-gmail-app-password
# Absolute URL for the "View in Dashboard" button in emails (defaults to the
# first ALLOWED_ORIGINS entry when unset).
DASHBOARD_URL=https://cropsphere.web.app